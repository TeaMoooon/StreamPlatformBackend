{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "StreamPlatformBackend",
    "Audience": "StreamPlatformUsers",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "AuthCookies": {
    "SameSite": "Lax",
    "Secure": "auto"
  },
  "Uploads": {
    "MaxImageBytes": 5242880
  },
  "Cors": {
    "AllowedOrigins": [
      "https://192.168.1.167",
      "http://192.168.1.167",
      "http://localhost:3000",
      "https://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Media": {
    "Path": "/var/www/streamplatform/media"
  },
  "Rtmp": {
    "Secret": "",
    "PublishUrl": "rtmp://localhost/live"
  },
  "AllowedHosts": "*"
