# Copy to /etc/streamplatform/backend.env (chmod 600) and point systemd EnvironmentFile at it.
# On a new server: also copy appsettings.Local.json.example → appsettings.Local.json and set real values.
# ASP.NET Core maps __ to nested config keys.

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=StreamDB;Username=postgres;Password=CHANGE_ME
ConnectionStrings__Redis=localhost:6379,abortConnect=false
Jwt__SecretKey=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32PLUS
Jwt__Issuer=StreamPlatformBackend
Jwt__Audience=StreamPlatformUsers
Rtmp__Secret=CHANGE_ME_MATCH_NGINX_NOTIFY_SECRET
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5156
